# ---------- 依赖 / 构建产物 ----------
node_modules/
dist/
*.log

# ---------- 外部克隆的第三方仓库（可重新 clone，见 README） ----------
ICT-FaceKit/

# ---------- 派生的中间数据（可由脚本重建，体积大） ----------
*.npy

# ---------- 证书私钥（敏感，绝不入库） ----------
certs/
*.pem
*.key

# ---------- OMX 运行时状态 ----------
.omx/

# ---------- 系统文件 ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- Blender 自动备份 ----------
*.blend1
*.blend2

# ---------- Python 缓存 ----------
__pycache__/
*.pyc

# ---------- MediaPipe 本地运行时（npm run vendor:mediapipe 生成，约 36MB） ----------
aniface-demo/public/mediapipe/

# ---------- 建模工作目录（work/）----------
# 真人照片与其调试图：绝不入库
work/assets/photo.jpg
work/assets/*.jpg
work/assets/lm_check.png
work/assets/head_pass*.png
# 迭代过程中的临时渲染（可重跑脚本生成）
work/assets/renders/tmp_*.png

